# Copy to .env for local development. Never commit .env.

# development | test | production
APP_ENV=development

# Medusa's own database, in the local Docker PostgreSQL.
DATABASE_URL=postgresql://shop:local-dev-only@127.0.0.1:5433/medusa

# Any value locally. Production needs 32 or more random characters.
JWT_SECRET=local-dev-jwt-secret
COOKIE_SECRET=local-dev-cookie-secret

# Optional locally (in-memory fallback). Required in production.
REDIS_URL=

STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000

# Razorpay test keys (Dashboard > Account & Settings > API Keys). Checkout stays closed without them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required in production. Webhook URL: <backend>/hooks/payment/razorpay_razorpay, event order.paid
RAZORPAY_WEBHOOK_SECRET=
