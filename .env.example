# Copy to .env for local development. Never commit .env.
# These values work only with the local Docker database.

# development | test | production
APP_ENV=development

# Public address of the shop. Production must be https://shop.divisiri.com
APP_URL=http://localhost:3000

# Local database from infra/docker/compose.yml (port 5433 avoids a host PostgreSQL on 5432)
DATABASE_URL=postgresql://shop:local-dev-only@127.0.0.1:5433/shop

# Optional until the payments milestone. Test keys outside production, live keys only in production.
RAZORPAY_KEY_ID=
